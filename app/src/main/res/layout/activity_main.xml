<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cliente REST Flask - AWS EC2"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:layout_marginBottom="20dp" />

        <!-- SECCIÓN 1: PETICIÓN GET (DATOS DE USUARIO) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Consulta de Usuario (GET)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/PH_txtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre: (Sin consultar)"
                android:textSize="16sp"
                android:textColor="#37474F"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/PH_txtCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo: (Sin consultar)"
                android:textSize="16sp"
                android:textColor="#37474F"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/PH_txtRut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RUT: (Sin consultar)"
                android:textSize="16sp"
                android:textColor="#37474F"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/PH_btnObtenerUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OBTENER DATOS (GET)"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- SECCIÓN 2: PETICIÓN POST (AUTENTICACIÓN JSON) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Validación de Acceso (POST)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/PH_inputLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ingrese su login (ej: patricio)"
                android:inputType="text"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/PH_inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ingrese su password (ej: 1234)"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/PH_btnLoginPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VALIDAR USUARIO (POST)"
                android:backgroundTint="#FF6D00"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/PH_txtResultadoPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Esperando credenciales..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#455A64" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>